# Copy to .env for local development (never commit .env).
APP_ENV=dev
APP_PORT=8080
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ngclass
DB_USERNAME=ngclass
DB_PASSWORD=ngclass_dev
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional overrides of the dev test accounts (defaults in application-dev.yaml)
# TEACHER_USERNAME=
# Test accounts of the dev profile (application-dev.yaml reads their passwords from here, never from git).
TEACHER_PASSWORD=
ADMIN_PASSWORD=
DEV_STUDENT_PASSWORD=
DEV_PARENT_PASSWORD=
